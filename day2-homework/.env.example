# Copy this file to .env for local development.
# In production on Databricks Apps, LAKEBASE_URL is injected from the
# "database_weather/lakebase-url" secret via app.yaml - do NOT put a real
# secret value in this file or commit a filled-in .env.

LAKEBASE_URL=postgresql://<role>:<password>@<your-lakebase-host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require
LAKEBASE_SECRET_SCOPE=database_weather
LAKEBASE_SECRET_KEY=lakebase-url

MASSIVE_API_BASE_URL=https://api.massive.example.com
MASSIVE_SECRET_SCOPE=massive
MASSIVE_SECRET_KEY=api-key

WEATHER_API_BASE_URL=https://api.weather.gov
# NWS requires a descriptive User-Agent identifying your app + a contact --
# generic User-Agents get throttled/blocked.
WEATHER_USER_AGENT=(databricks-lakebase-day2-homework, you@example.com)
